# Example environment (override in CI or secrets manager)
NEXT_PUBLIC_API_URL=http://localhost:8080
POSTGRES_DSN=postgres://opensig:opensig@postgres:5432/opensig?sslmode=disable
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=opensig
S3_SECRET_KEY=opensigsecret
S3_BUCKET=opensig-assets

# Microsoft Graph / Entra ID Authentication
# Register an app in Azure Portal: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Required for OAuth 2.0 authorization code flow (web authentication)
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=common
AZURE_REDIRECT_URL=http://localhost:8080/auth/callback
